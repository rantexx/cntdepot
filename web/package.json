{
  "name": "depot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "gen": "orval --config orval.config.ts",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').writeFileSync('../internal/webui/dist/.gitkeep', '')\""
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@refinedev/core": "^5.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "orval": "^8.48.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
