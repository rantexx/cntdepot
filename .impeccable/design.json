      "html": "<a class=\"ds-visit\" href=\"#\"><i class=\"ds-tile\"></i><span>09:41</span><span class=\"ds-vcn\">MSCU 123456<span class=\"ds-vcd\">7</span></span><span>22G1</span><span><span class=\"ds-vsign\">Accepted</span></span><span class=\"ds-gt\"><span class=\"ds-bar\"><span style=\"width:38%\"></span></span><b>46 s</b></span></a>",
      "css": ".ds-visit{font-family:\"Barlow Semi Condensed\",system-ui,sans-serif;font-variant-numeric:tabular-nums;display:grid;grid-template-columns:12px 64px 200px 64px minmax(0,1fr) 280px;gap:14px;align-items:center;min-height:48px;border-top:1px solid var(--rule,#cbcbc3);color:var(--ink,#1e2226);text-decoration:none;font-size:20px;font-weight:500;padding:4px 0}.ds-visit:hover{background:var(--rule-soft,#e2e2dc)}.ds-visit:focus-visible{outline:3px solid var(--focus,#1f5fa8);outline-offset:2px}.ds-tile{display:inline-block;width:12px;height:26px;border-radius:2px;background:var(--safe,#0d8045)}.ds-vcn{white-space:nowrap;letter-spacing:.03em;font-weight:600}.ds-vcd{display:inline-block;border:2px solid currentColor;border-radius:2px;padding:0 .22em;margin-left:.3em;line-height:1.05}.ds-vsign{display:inline-block;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:.06em;padding:3px 9px;border-radius:3px;color:#fff;background:var(--safe,#0d8045)}.ds-gt{display:flex;align-items:center;gap:12px;justify-content:flex-end}.ds-bar{width:150px;height:8px;background:var(--track,#dad9d2);position:relative;display:block}.ds-bar>span{position:absolute;left:0;top:0;bottom:0;background:var(--safe,#0d8045)}.ds-bar::after{content:'';position:absolute;left:50%;top:-5px;bottom:-5px;width:2px;background:var(--ink,#1e2226)}.ds-gt b{min-width:92px;text-align:right;font-weight:600}"
