      "html": "<span class=\"ds-sign ds-reading\">Reading</span> <span class=\"ds-sign ds-act\">Act now</span> <span class=\"ds-sign ds-caution\">Needs review</span> <span class=\"ds-sign ds-safe\">Accepted</span> <span class=\"ds-sign ds-stop\">Refused</span> <span class=\"ds-sign ds-none\">No container</span>",
      "css": ".ds-sign{font-family:\"Barlow Semi Condensed\",system-ui,sans-serif;font-variant-numeric:tabular-nums;display:inline-block;font-weight:700;font-size:14px;line-height:1.3;text-transform:uppercase;letter-spacing:.06em;padding:3px 9px;border-radius:3px;color:#fff;white-space:nowrap;background:var(--none,#6c7378)}.ds-safe{background:var(--safe,#0d8045)}.ds-caution{background:var(--caution,#f2c200);color:#1e2226}.ds-act{background:var(--act,#1f5fa8)}.ds-stop{background:var(--stop,#c8202a)}.ds-none{background:var(--none,#6c7378)}.ds-reading{background:var(--panel,#fff);color:var(--ink,#1e2226);box-shadow:inset 0 0 0 2px var(--ink,#1e2226)}"
